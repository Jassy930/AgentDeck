    "ToBeSignedV1": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "definitions": {
        "SignedObjectType": {
          "description": "被签对象类型（域分隔的一部分，避免跨对象重签）。",
          "enum": [
            "linkCert",
            "dataCert",
            "relayGrant",
            "deviceAuthorization",
            "deviceRevocation",
            "retireMachine",
            "downlinkData",
            "uplinkRequest",
            "pairingProof"
          ],
          "type": "string"
        },
        "StreamCursor": {
          "description": "两层 sequence 的外层订阅 cursor（design §9.1）。\n\n统一使用 `BeforeFirst | At(u64)`，**绝不把 SQLite `-1` 编进 unsigned wire**： `Subscribe(BeforeFirst)` 表示从 frame 0 开始。wire 表示： `BeforeFirst → \"beforeFirst\"`，`At(n) → { \"at\": n }`。",
          "oneOf": [
            {
              "enum": [
                "beforeFirst"
              ],
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "at": {
                  "format": "uint64",
                  "minimum": 0.0,
                  "type": "integer"
                }
              },
              "required": [
                "at"
              ],
              "type": "object"
            }
          ]
        }
      },
      "description": "确定性签名 preimage（design §6.6 公共前缀）。",
