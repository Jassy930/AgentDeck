          "type": [
            "string",
            "null"
          ]
        },
        "e2eeFormatVersion": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "machineRoute": {
          "type": "string"
        },
        "notAfterMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "objectType": {
          "$ref": "#/definitions/SignedObjectType"
        },
        "relayProtocolVersion": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "relayServerId": {
          "type": "string"
        },
        "requestRoute": {
          "type": [
            "string",
            "null"
          ]
        },
        "roleScope": {
          "type": "string"
        },
        "rootKeyId": {
          "type": "string"
        },
        "runtimeProtocolVersion": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "serialOrGeneration": {
          "description": "grant serial 或 link/data generation（同一 authority 的单调值）。",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "signatureFormatVersion": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "signedObjectSha256": {
          "type": "string"
        },
        "signingKeyFingerprint": {
          "type": "string"
        },
        "streamCursor": {
          "anyOf": [
            {
              "$ref": "#/definitions/StreamCursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "streamGeneration": {
          "type": [
            "string",
            "null"
          ]
        },
        "streamRoute": {
          "type": [
            "string",
            "null"
          ]
        },
        "trustEpoch": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "e2eeFormatVersion",
        "machineRoute",
        "objectType",
        "relayProtocolVersion",
        "relayServerId",
        "roleScope",
        "rootKeyId",
        "runtimeProtocolVersion",
        "serialOrGeneration",
        "signatureFormatVersion",
        "signedObjectSha256",
        "signingKeyFingerprint",
        "trustEpoch"
      ],
      "title": "ToBeSignedV1",
      "type": "object"
    },
