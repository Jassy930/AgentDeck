{
  "name": "agentdeck-relay-test-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "trustedDependencies": ["wasm-pack"],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:w1": "AGENTDECK_WEB_CORE_FEATURES=w1-test-fixture bun run scripts/build.ts",
    "check": "tsc --noEmit && bun run scripts/check-protocol-ownership.ts",
    "serve:test": "bun run scripts/server.ts",
    "test:unit": "bun test tests/unit",
    "test:browser": "bun run build && bun run scripts/test-browser.ts",
    "test:browser:built": "bun run scripts/test-browser.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "bun-types": "1.3.14",
    "typescript": "5.9.2",
    "wasm-pack": "0.15.0"
  }
}
