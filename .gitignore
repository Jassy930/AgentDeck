# macOS
.DS_Store

# Xcode
*.xcuserstate
*.xcscmblueprint
xcuserdata/
DerivedData/
build/
dist/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Swift Package Manager
.swiftpm/
.build/
Package.resolved

# Rust
target/
**/*.rs.bk

# AgentDeck local data (never committed — managed by AgentDeck itself)
# Run records / diagnostic logs live in ~/Library/Application Support/AgentDeck/
# NOT in the repo. This entry is a guard in case of accidental local writes.
.agentdeck/

# Local git worktrees
.worktrees/

# Agent 工具本地产物（各家 CLI 的会话/技能缓存，不入库）
# 例外：仓库自有 skill 入库，正本在 .agents/skills/，.claude/skills/ 下是符号链接。
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/agentdeck-release/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/agentdeck-release
.codex/
skills-lock.json

# Editor
*.swp
.idea/
.vscode/

# Env / secrets
.env
*.local

# iOS XcodeGen output
ios/AgentDeckMobile.xcodeproj/
ios/AgentDeckMobile/Info.plist
ios/DerivedData/
